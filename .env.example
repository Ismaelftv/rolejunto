# ===== RolêJunto — copie para .env e preencha =====
NODE_ENV=production
PORT=3333

# Seu domínio (sem https://). O site, a API (/api) e as fotos (/uploads) ficam todos nele.
DOMAIN=seudominio.com.br

# Segurança (gere cada um com: openssl rand -base64 48)
COOKIE_SECRET=
DB_PASSWORD=
# Já tinha o sistema rodando com o nome antigo e quer manter os dados? Use DB_NAME=parcerto e DB_USER=parcerto.
# DB_NAME=rolejunto
# DB_USER=rolejunto

# Regras de negócio
SERVICE_FEE_RATE=0.1
LATE_CANCEL_REFUND_RATE=0.5
MIN_AGE=18

# Pagamentos: mock (testes, sem cobrança) ou mercadopago
PAYMENT_PROVIDER=mock
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# E-mail pelo Gmail (código de confirmação, recuperação de senha, suporte)
# GMAIL_APP_PASSWORD é a "senha de app" de 16 letras, NÃO a senha normal do Gmail. Passo a passo no README.
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=
# Nome que aparece como remetente (o endereço tem de ser o próprio Gmail)
EMAIL_FROM=RolêJunto <seuemail@gmail.com>
# Se a VPS bloquear o Gmail (portas 465/587), use o Brevo, que envia por HTTPS (tem prioridade sobre o Gmail):
BREVO_API_KEY=
# Outro provedor no lugar do Gmail (opcional): smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=

# Login com Google e Apple (opcional; sem isso os botões não aparecem). Passo a passo no README, seção 4.
# GOOGLE_CLIENT_ID: "ID do cliente" OAuth do tipo "Aplicativo da Web" (termina em .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID: o "Services ID" criado no Apple Developer (ex.: br.com.rolejunto.web)
APPLE_CLIENT_ID=

# Indique um amigo: valor do cupom que cada um ganha (em centavos; 2000 = R$ 20,00). 0 desliga.
REFERRAL_REWARD_CENTS=2000
# Exigir foto real aprovada antes de o parceiro aparecer na busca (recomendado: true)
REQUIRE_PARTNER_PHOTO=true

# Mapa (opcional). O padrão usa os servidores do OpenStreetMap, bons para começar.
# Com muito acesso, use um provedor (MapTiler, Stadia, Carto...). Exemplo MapTiler:
# MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=SUA_CHAVE
# MAP_ATTRIBUTION=© MapTiler © OpenStreetMap
MAP_TILES_URL=
MAP_ATTRIBUTION=

# Primeiro administrador (opcional; também dá para criar depois com o comando create-admin)
ADMIN_EMAIL=
