# Site do RolêJunto + API no mesmo domínio, com HTTPS automático (Let's Encrypt)
{$DOMAIN} {
	# compressão em tudo, menos no canal de tempo real (que precisa sair na hora)
	@compress not path /api/events
	encode @compress zstd gzip

	# API e fotos enviadas
	handle /api/* {
		reverse_proxy api:3333
	}
	handle /uploads/* {
		reverse_proxy api:3333
	}

	# Site (React): arquivos estáticos e rotas do app
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /sw.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(self)"
	}
}

# www → domínio principal
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
