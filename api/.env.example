# Configuração da API para rodar separada (em desenvolvimento não precisa de .env).
# Para produção com Docker, use o .env.example da pasta principal.
NODE_ENV=development
PORT=3333
# DATABASE_URL=postgres://usuario:senha@localhost:5432/rolejunto   (sem isso, usa o banco embutido em ./data)
APP_URL=http://localhost:5173
PUBLIC_URL=http://localhost:3333
COOKIE_SECRET=troque-este-segredo-em-producao
PAYMENT_PROVIDER=mock
SMTP_URL=
# Para enviar e-mails de verdade também no computador (passo a passo no README principal):
# GMAIL_USER=seuemail@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
